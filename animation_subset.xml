<?xml version="1.0"?>
<tweaks>

	<!-- 
		add a new recoil subset for the claire 12g
		to fix the issue where claire 12g cannot use auto-fire without crashing
		due to trying to use autofire anims
	-->
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_subset">
		<search>
			<xml/>
				<anim name="coach_recoil_exit"/>
		</search>
		<target mode="append">
			<anim name="coach_recoil_enter" file="anims/fps/coach/coach_recoil" blend_set="all"/>
		</target>
		
	</tweak>

	<!-- add anim entries for the tripmine and fak; fak reuses tripmine throwable anims -->
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_subset">
		<search>
			<xml/>
			<anim name="throw_jav_equip"/>
		</search>
		<target mode="append">
			<anim name="throw_tripmine_throwable" file="anims/fps/unarmed/throw_tripmine_throwable" blend_set="all"/>
			<anim name="throw_tripmine_throwable_equip" file="anims/fps/unarmed/throw_tripmine_throwable_equip" blend_set="all"/>
			<anim name="throw_tripmine_throwable_idle" file="anims/fps/unarmed/throw_tripmine_throwable_idle" blend_set="all"/>
			<anim name="throw_fak_throwable" file="anims/fps/unarmed/throw_tripmine_throwable" blend_set="all"/>
			<anim name="throw_fak_throwable_equip" file="anims/fps/unarmed/throw_tripmine_throwable_equip" blend_set="all"/>
			<anim name="throw_fak_throwable_idle" file="anims/fps/unarmed/throw_tripmine_throwable_idle" blend_set="all"/>
		</target>
		
	</tweak>
</tweaks>
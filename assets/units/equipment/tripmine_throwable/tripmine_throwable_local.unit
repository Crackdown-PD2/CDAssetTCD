<?xml version="1.0"?>
<unit type="item" slot="13">
	<object file="units/equipment/tripmine_throwable/tripmine_throwable" />
	<extensions>
		<extension name="base" class="TripmineThrowableBase" >
			<var name="_tweak_projectile_entry" value="tripmine_throwable" />
		</extension>
		<extension name="unit_data" class="ScriptUnitData" />
		<extension name="damage" class="UnitDamage" >
			<var name="_skip_give_body_collision_damage" value="true" />
		</extension>
		<extension name="contour" class="ContourExt" />
	</extensions>
	<sounds>
		<default_soundsource source="g_g" />
		<soundsource name="snd" source="g_g" />
	</sounds>
</unit> 

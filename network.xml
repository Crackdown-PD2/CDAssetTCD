<?xml version="1.0"?>
<tweaks>
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
			<message name="sync_drill_upgrades"/>
		</search>
		<target mode="replace">
			<message name="sync_drill_upgrades" delivery="ordered" receiver="unit">
				<param type="unit" />	<!-- unit -->
				<param type="int" min="0" max="2" /> <!-- static defense -->
				<param type="int" min="0" max="2" /> <!-- automatic repair -->
				<param type="int" min="0" max="2" /> <!-- drill speed level (Investing IBE) -->
				<param type="bool" /> <!-- silent (Perfect Alignment) -->
				<param type="bool" /> <!-- static alert (Static Defense) -->
			</message>
		</target>
	</tweak>
	
	
	
	
	
	
	
	<!-- ==================================== TRIPMINES -->
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
			<message name="place_trip_mine"/>
		</search>
		<target mode="replace">
		
		<message name="place_trip_mine" delivery="ordered" receiver="unit" check="client_to_server">
			<param type="vector3" />			<!-- Position -->
			<param type="vector3" />			<!-- Normal of place surface -->
			<param type="int" min="0" max="15" /> <!-- Upgrade bits -->
			<param type="int" min="0" max="4" /> <!-- Payload Mode -->
			<param type="bool" /> 				<!-- toggle: Special targeting only -->
		</message>
		
		</target>
	</tweak>
	
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
			<message name="sync_trip_mine_setup"/>
		</search>
		<target mode="replace">
		
		<message name="sync_trip_mine_setup" delivery="ordered" receiver="unit" check="server_to_client">
			<param type="unit" />
			<param type="int" min="0" max="15"/> <!-- Peer id -->
			<param type="int" min="0" max="15" /> <!-- Upgrade bits -->
			<param type="int" min="0" max="4" /> <!-- Payload Mode -->
			<param type="bool" /> 				<!-- toggle: Special targeting only -->
		</message>
		
		<message name="request_spawn_attach_trip_mine" delivery="ordered" receiver="unit" check="client_to_server">
			<param type="unit" />		<!-- attach to unit -->
			<param type="body" />		<!-- attach to body -->
			<param type="object3d" />	<!-- attach object -->
			<param type="vector3" />	<!-- local position -->
			<param type="vector3" />	<!-- direction -->
			<param type="int" min="0" max="15" /> <!-- Upgrade bits -->
			<param type="int" min="0" max="4" /> <!-- Payload Mode -->
			<param type="bool" /> 				<!-- toggle: Special targeting only -->
		</message>
		
		<message name="sync_spawn_attach_trip_mine" delivery="ordered" receiver="unit" check="server_to_client">
			<param type="unit" />		<!-- attach to unit -->
			<param type="body" />		<!-- attach to body -->
			<param type="object3d" />	<!-- attach object -->
			<param type="vector3" />	<!-- local position -->
			<param type="vector3" />	<!-- direction -->
			<param type="int" min="0" max="15"/> <!-- Peer id -->
			<param type="int" min="0" max="15" /> <!-- Upgrade bits -->
			<param type="int" min="0" max="4" /> <!-- Payload Mode -->
			<param type="bool" /> 				<!-- toggle: Special targeting only -->
		</message>
		
		</target>
	</tweak>








	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<message name="from_server_early_hostage_trade_response" delivery="ordered" receiver="unit"  check="server_to_client">
				<param type="unit" />	<!-- unit -->
				<param type="bool" /> <!-- success -->
				<param type="int" min="0" max="2" /> <!-- reason -->
			</message>
		</target>
	</tweak>
	
	<tweak version="2" name="settings/network" extension="network_settings">
		<search>
			<network/>
			<rpc/>
		</search>
		<target mode="attach">
			<message name="request_early_hostage_trade" delivery="ordered" receiver="unit"  check="client_to_server">
				<param type="unit" />	<!-- unit -->
			</message>
		</target>
	</tweak>
	
